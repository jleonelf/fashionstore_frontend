{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fashionstore.local/contratos/segundo-parcial/0.4.0/operacion.schema.json",
  "title": "Operación de sincronización FashionStore",
  "type": "object",
  "required": [
    "version_esquema",
    "operacion_id",
    "tipo",
    "creada_local_en",
    "empresa_id",
    "usuario_id",
    "dispositivo_id",
    "secuencia_local",
    "datos"
  ],
  "properties": {
    "version_esquema": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "operacion_id": {
      "type": "string",
      "format": "uuid"
    },
    "tipo": {
      "enum": [
        "SOLICITAR_RESERVA",
        "SOLICITAR_COMPRA",
        "REGISTRAR_VENTA_CAJA"
      ]
    },
    "creada_local_en": {
      "type": "string",
      "format": "date-time"
    },
    "empresa_id": {
      "type": "string",
      "format": "uuid"
    },
    "usuario_id": {
      "type": "string",
      "format": "uuid"
    },
    "dispositivo_id": {
      "type": "string",
      "format": "uuid"
    },
    "secuencia_local": {
      "type": "integer",
      "minimum": 1
    },
    "referencia_horaria_id": {
      "type": "string",
      "format": "uuid"
    },
    "datos": {
      "type": "object",
      "description": "SOLICITAR_COMPRA v3 puede omitir autorizacion_cobro para registrar pendiente sin cobro; si se incluye, debe estar completa. No datos de tarjeta."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "SOLICITAR_RESERVA"
          }
        }
      },
      "then": {
        "properties": {
          "version_esquema": {
            "const": 1
          },
          "datos": {
            "$ref": "#/$defs/reserva"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "SOLICITAR_COMPRA"
          }
        }
      },
      "then": {
        "properties": {
          "datos": {
            "$ref": "#/$defs/compra"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "REGISTRAR_VENTA_CAJA"
          }
        }
      },
      "then": {
        "properties": {
          "datos": {
            "$ref": "#/$defs/venta_caja"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version_esquema": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "tipo": {
            "const": "SOLICITAR_COMPRA"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "SOLICITAR_COMPRA"
          },
          "version_esquema": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "datos": {
            "required": [
              "modalidad"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "modalidad": {
                      "const": "DELIVERY"
                    }
                  }
                },
                "then": {
                  "required": [
                    "direccion"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version_esquema": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "tipo": {
            "const": "SOLICITAR_COMPRA"
          },
          "datos": {
            "$ref": "#/$defs/compra_v3"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "SOLICITAR_COMPRA"
          },
          "version_esquema": {
            "enum": [
              1,
              2
            ]
          }
        }
      },
      "then": {
        "properties": {
          "datos": {
            "not": {
              "required": [
                "autorizacion_cobro"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "enum": [
              "SOLICITAR_RESERVA",
              "REGISTRAR_VENTA_CAJA"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "version_esquema": {
            "const": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "linea": {
      "type": "object",
      "required": [
        "variante_id",
        "cantidad"
      ],
      "properties": {
        "variante_id": {
          "type": "string",
          "format": "uuid"
        },
        "cantidad": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "reserva": {
      "type": "object",
      "required": [
        "sucursal_id",
        "visita_en",
        "lineas"
      ],
      "properties": {
        "sucursal_id": {
          "type": "string",
          "format": "uuid"
        },
        "visita_en": {
          "type": "string",
          "format": "date-time"
        },
        "lineas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/linea"
          }
        }
      }
    },
    "compra": {
      "type": "object",
      "required": [
        "sucursal_id",
        "lineas"
      ],
      "properties": {
        "sucursal_id": {
          "type": "string",
          "format": "uuid"
        },
        "lineas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/linea"
              }
            ],
            "type": "object",
            "required": [
              "precio_visto_bob"
            ],
            "properties": {
              "precio_visto_bob": {
                "$ref": "#/$defs/importe"
              }
            }
          }
        },
        "modalidad": {
          "enum": [
            "RECOJO",
            "DELIVERY"
          ]
        },
        "direccion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "venta_caja": {
      "type": "object",
      "required": [
        "turno_id",
        "habilitacion_id",
        "version_precios",
        "vendida_local_en",
        "lineas",
        "total_bob",
        "efectivo_recibido_bob",
        "entregada_local_en"
      ],
      "properties": {
        "turno_id": {
          "type": "string",
          "format": "uuid"
        },
        "habilitacion_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_precios": {
          "type": "string",
          "minLength": 1
        },
        "vendida_local_en": {
          "type": "string",
          "format": "date-time"
        },
        "entregada_local_en": {
          "type": "string",
          "format": "date-time"
        },
        "total_bob": {
          "$ref": "#/$defs/importe"
        },
        "efectivo_recibido_bob": {
          "$ref": "#/$defs/importe"
        },
        "cambio_entregado_bob": {
          "$ref": "#/$defs/importe"
        },
        "cliente_id": {
          "type": "string",
          "format": "uuid"
        },
        "lineas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/linea"
              }
            ],
            "type": "object",
            "required": [
              "precio_autorizado_bob"
            ],
            "properties": {
              "precio_autorizado_bob": {
                "$ref": "#/$defs/importe"
              }
            }
          }
        }
      }
    },
    "importe": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "autorizacion_cobro": {
      "type": "object",
      "required": [
        "consentimiento_id",
        "aceptado_local_en",
        "huella_compra",
        "base_bob",
        "descuento_bob",
        "envio_bob",
        "total_bob",
        "moneda_cobro",
        "importe_cobro",
        "tasa_id",
        "tasa_bob_por_usd",
        "condiciones_version",
        "vigente_hasta",
        "preparacion_pago_id",
        "permite_cobro_al_reconectar"
      ],
      "additionalProperties": false,
      "properties": {
        "consentimiento_id": {
          "type": "string",
          "format": "uuid"
        },
        "aceptado_local_en": {
          "type": "string",
          "format": "date-time"
        },
        "huella_compra": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "base_bob": {
          "$ref": "#/$defs/importe"
        },
        "descuento_bob": {
          "$ref": "#/$defs/importe"
        },
        "envio_bob": {
          "$ref": "#/$defs/importe"
        },
        "total_bob": {
          "$ref": "#/$defs/importe"
        },
        "moneda_cobro": {
          "const": "USD"
        },
        "importe_cobro": {
          "$ref": "#/$defs/importe"
        },
        "tasa_id": {
          "type": "string",
          "format": "uuid"
        },
        "tasa_bob_por_usd": {
          "type": "string",
          "pattern": "^([1-9][0-9]*(\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
        },
        "condiciones_version": {
          "type": "string",
          "minLength": 1
        },
        "vigente_hasta": {
          "type": "string",
          "format": "date-time"
        },
        "preparacion_pago_id": {
          "type": "string",
          "format": "uuid"
        },
        "permite_cobro_al_reconectar": {
          "const": true
        }
      }
    },
    "compra_v3": {
      "allOf": [
        {
          "$ref": "#/$defs/compra"
        },
        {
          "type": "object",
          "required": [
            "modalidad"
          ],
          "properties": {
            "autorizacion_cobro": {
              "$ref": "#/$defs/autorizacion_cobro"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "modalidad": {
                    "const": "DELIVERY"
                  }
                }
              },
              "then": {
                "required": [
                  "direccion"
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "$comment": "CU04 usa reserva v1. Las operaciones nuevas llevan fechas ISO8601 con offset Bolivia y referencia_horaria_id; el campo sigue opcional en este esquema para leer pendientes v1 antiguos. El servidor valida ámbito, tiempo y compatibilidad. Solo compra v3 permite consentimiento específico y cobro conectado posterior. Reglas de huella/sumas/vigencia se validan en servidor."
}
