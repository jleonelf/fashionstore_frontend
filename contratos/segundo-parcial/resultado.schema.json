{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fashionstore.local/contratos/segundo-parcial/0.1.0/resultado.schema.json",
  "title": "Resultado durable de sincronización FashionStore",
  "type": "object",
  "required": ["operacion_id", "estado", "codigo", "recibida_en", "detalle"],
  "properties": {
    "operacion_id": {"type": "string", "format": "uuid"},
    "estado": {"enum": ["ACEPTADA", "RECHAZADA", "REQUIERE_ACEPTACION_PRECIO", "PENDIENTE_PAGO", "REGISTRADA_CENTRAL", "CONCILIACION_REQUERIDA"]},
    "codigo": {"enum": ["OK", "SIN_STOCK", "PRECIO_CAMBIADO", "SOLICITUD_VENCIDA", "TIEMPO_INCOHERENTE", "PLAN_NO_HABILITADO", "CUPO_INSUFICIENTE", "TASA_NO_VIGENTE", "OPERACION_MODIFICADA", "PAGO_EN_VERIFICACION"]},
    "recibida_en": {"type": "string", "format": "date-time"},
    "aceptada_en": {"type": "string", "format": "date-time"},
    "vence_en": {"type": "string", "format": "date-time"},
    "recurso_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "venta_id": {"type": "string", "format": "uuid"},
    "total_bob": {"$ref": "#/$defs/importe"},
    "total_usd": {"$ref": "#/$defs/importe"},
    "tasa_bob_por_usd": {"type": "string", "pattern": "^([1-9][0-9]*(\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"},
    "faltantes": {"type": "array", "items": {"type": "object", "required": ["variante_id", "cantidad_solicitada"], "properties": {"variante_id": {"type": "string", "format": "uuid"}, "cantidad_solicitada": {"type": "integer", "minimum": 1}}}},
    "detalle": {"type": "string"}
  },
  "$defs": {
    "importe": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"}
  }
}
