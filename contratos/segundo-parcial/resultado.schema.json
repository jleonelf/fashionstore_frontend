{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fashionstore.local/contratos/segundo-parcial/0.4.0/resultado.schema.json",
  "title": "Resultado durable de sincronización FashionStore",
  "type": "object",
  "required": [
    "operacion_id",
    "estado",
    "codigo",
    "recibida_en",
    "detalle"
  ],
  "properties": {
    "operacion_id": {
      "type": "string",
      "format": "uuid"
    },
    "estado": {
      "enum": [
        "ACEPTADA",
        "RECHAZADA",
        "REQUIERE_ACEPTACION_PRECIO",
        "PENDIENTE_PAGO",
        "REGISTRADA_CENTRAL",
        "CONCILIACION_REQUERIDA",
        "CONFLICTO",
        "PAGADO_PENDIENTE_ASIGNACION",
        "CONFIRMADO",
        "REEMBOLSO_PENDIENTE",
        "REEMBOLSADO",
        "PENDIENTE_INTERVENCION",
        "REQUIERE_NUEVA_ACEPTACION",
        "REQUIERE_ACCION_CLIENTE",
        "CANCELACION_EN_CONCILIACION",
        "CANCELADA"
      ]
    },
    "codigo": {
      "enum": [
        "OK",
        "SIN_STOCK",
        "PRECIO_CAMBIADO",
        "SOLICITUD_VENCIDA",
        "TIEMPO_INCOHERENTE",
        "PLAN_NO_HABILITADO",
        "CUPO_INSUFICIENTE",
        "TASA_NO_VIGENTE",
        "OPERACION_MODIFICADA",
        "PAGO_EN_VERIFICACION",
        "COBRO_CONFIRMADO",
        "PEDIDO_NO_CUMPLIBLE",
        "REEMBOLSO_EN_PROCESO",
        "REEMBOLSO_COMPLETADO",
        "METODO_NO_PREPARADO",
        "AUTORIZACION_INSUFICIENTE",
        "OFERTA_CAMBIADA",
        "ACCION_PROVEEDOR_REQUERIDA",
        "CANCELACION_EN_CURSO",
        "SOLICITUD_CANCELADA"
      ]
    },
    "recibida_en": {
      "type": "string",
      "format": "date-time"
    },
    "aceptada_en": {
      "type": "string",
      "format": "date-time"
    },
    "vence_en": {
      "type": "string",
      "format": "date-time"
    },
    "recurso_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "venta_id": {
      "type": "string",
      "format": "uuid"
    },
    "total_bob": {
      "$ref": "#/$defs/importe"
    },
    "total_usd": {
      "$ref": "#/$defs/importe"
    },
    "tasa_bob_por_usd": {
      "type": "string",
      "pattern": "^([1-9][0-9]*(\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
    },
    "faltantes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "variante_id",
          "cantidad_solicitada"
        ],
        "properties": {
          "variante_id": {
            "type": "string",
            "format": "uuid"
          },
          "cantidad_solicitada": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "detalle": {
      "type": "string"
    },
    "pedido_id": {
      "type": "string",
      "format": "uuid"
    },
    "pago_id": {
      "type": "string",
      "format": "uuid"
    },
    "reembolso_id": {
      "type": "string",
      "format": "uuid"
    },
    "estado_pago": {
      "type": "string"
    },
    "estado_cumplimiento": {
      "type": "string"
    }
  },
  "$defs": {
    "importe": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
    }
  },
  "$comment": "Resultado durable de operación, sin prueba de cobro por cola local. Estados nuevos requieren protocolo 0.4.0 negociado. COBRO_CONFIRMADO se respalda por proveedor/webhook/reconciliación; cancelación en carrera se consulta antes de repetir."
}
